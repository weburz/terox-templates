{
  "name": "{{ .PackageName }}",
  "version": "0.0.1",
  "description": "{{ .PackageDescription }}",
  "keywords": [
    "typescript"
  ],
  "license": "MIT",
  "author": "{{ .AuthorName }}",
  "homepage": "https://github.com/{{ .GitHubOwner }}/{{ .GitHubRepo }}#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ .GitHubOwner }}/{{ .GitHubRepo }}.git"
  },
  "bugs": {
    "url": "https://github.com/{{ .GitHubOwner }}/{{ .GitHubRepo }}/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "unbuild",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "tsc --noEmit",
    "prepack": "pnpm build",
    "release": "pnpm lint && pnpm test && pnpm test:types && pnpm build && changelogen --release && pnpm publish && git push --follow-tags",
    "setup:hooks": "pre-commit install && pre-commit install --hook-type commit-msg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20",
    "changelogen": "^0.6.2",
    "eslint": "^10.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0",
    "unbuild": "^3.5.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
